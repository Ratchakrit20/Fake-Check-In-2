# คัดลอกไฟล์นี้เป็น .env แล้ว restart Backend ทุกครั้งหลังแก้ค่า
# ค่าที่ไม่ใส่จะใช้ค่าเริ่มต้นจาก config/default.yaml
# ค่า ratio/similarity/coverage ใช้ช่วง 0–1 เช่น 0.65 = 65%

# -----------------------------------------------------------------------------
# ระบบและ Production
# -----------------------------------------------------------------------------
APP__RELOAD=false
DATABASE__URL=sqlite+aiosqlite:///./data/app.db
JOBS__BROKER_URL=redis://localhost:6379/0
JOBS__RESULT_BACKEND=redis://localhost:6379/1

# -----------------------------------------------------------------------------
# SSCD + FAISS: หา Candidate ก่อนตรวจละเอียด
# -----------------------------------------------------------------------------
EMBEDDING__DEVICE=auto
EMBEDDING__MODEL_PATH=data/models/sscd_disc_mixup.torchscript.pt
EMBEDDING__INPUT_SIZE=320
# 0 = เลือก batch อัตโนมัติตาม CPU/VRAM; เพิ่มอาจเร็วขึ้นแต่ใช้ RAM/VRAM มากขึ้น
EMBEDDING__BATCH_SIZE=0
# เพิ่ม = ตรวจ Candidate มากขึ้น แม่น recall ขึ้นแต่ช้าลง; ลด = เร็วขึ้นแต่อาจพลาด
VECTOR_SEARCH__TOP_K=30
# เพิ่ม = ตัด Candidate มากขึ้นและเร็วขึ้น แต่อาจพลาดภาพแก้ไขหนัก; ลด = ตรวจมากขึ้นและช้าลง
PERFORMANCE__CANDIDATE_MIN_SIMILARITY=0.40

# -----------------------------------------------------------------------------
# pHash: ภาพรวม ภาพกลับด้าน และภาพหมุน
# -----------------------------------------------------------------------------
PHASH__HASH_SIZE=8
# เพิ่ม = ยอมให้ภาพรวมต่างกันมากขึ้น; ลด = เข้มงวดขึ้น
PHASH__MAX_HAMMING_DISTANCE=10
# เกณฑ์ same_image โดยเฉพาะ; เพิ่ม = ยอมรับภาพต่างขึ้น; ลด = ต้องเหมือนมากขึ้น
RELATIONSHIP__SAME_IMAGE_PHASH_MAX=4

# -----------------------------------------------------------------------------
# SIFT: หาจุดรายละเอียดที่ตรงกัน
# -----------------------------------------------------------------------------
# ลด = เร็ว/ใช้ RAM น้อยแต่เสียรายละเอียด; เพิ่ม = ละเอียดขึ้นแต่ช้าลง
SIFT__MAX_DIMENSION=1280
# ลด = พบ keypoint มากขึ้นรวม noise; เพิ่ม = เหลือเฉพาะจุดเด่นชัด
SIFT__CONTRAST_THRESHOLD=0.02
# เพิ่ม = เก็บจุดตามขอบมากขึ้น; ลด = กรองจุดตามขอบมากขึ้น
SIFT__EDGE_THRESHOLD=15
SIFT__SIGMA=1.2
# เพิ่ม = รับคู่จุดมากขึ้นแต่ false match สูงขึ้น; ลด = เข้มงวดขึ้น
SIFT__RATIO_THRESHOLD=0.75
# เพิ่ม = ต้องมีจุดตรงกันมากขึ้น; ลด = ตรวจจับภาพยาก/เบลอได้ง่ายขึ้นแต่เสี่ยง false positive
SIFT__MIN_GOOD_MATCHES=12

# -----------------------------------------------------------------------------
# RANSAC: ยืนยันว่าจุด SIFT สัมพันธ์กันทางเรขาคณิตจริง
# -----------------------------------------------------------------------------
# เพิ่ม = ยอมรับตำแหน่งคลาดเคลื่อนมากขึ้น; ลด = จัดแนวต้องแม่นขึ้น
RANSAC__REPROJECTION_THRESHOLD=5.0
# เพิ่ม = ต้องมีสัดส่วนจุดถูกต้องมากขึ้น; ลด = ผ่านง่ายขึ้น
RANSAC__MIN_INLIER_RATIO=0.40
# เพิ่ม = ต้องมีจุดยืนยันมากขึ้น; ลด = ภาพเบลอ/ครอปผ่านง่ายขึ้นแต่เสี่ยง false positive
RANSAC__MIN_INLIERS=8
FLIP_DETECTION__HORIZONTAL=true

# -----------------------------------------------------------------------------
# โมเดลอวัยวะ
# -----------------------------------------------------------------------------
BODY_PARTS__ENABLED=true
BODY_PARTS__MODEL_PATH=data/models/human_mask/organ.pt
BODY_PARTS__DEVICE=auto
# เพิ่ม = mask ละเอียดขึ้นแต่ช้าลง/ใช้ VRAM มากขึ้น
BODY_PARTS__IMAGE_SIZE=640
# เพิ่ม = รับเฉพาะอวัยวะที่โมเดลมั่นใจ; ลด = ตรวจเจอง่ายขึ้นแต่ mask ผิดเพิ่ม
BODY_PARTS__CONFIDENCE=0.35
BODY_PARTS__CACHE_SIZE=256
# เพิ่มค่าด้านล่าง = body reuse เข้มงวดขึ้น; ลด = ผ่านง่ายขึ้น
BODY_PARTS__MIN_REUSE_CLASSES=2
BODY_PARTS__MIN_REUSE_INLIERS=18
BODY_PARTS__MIN_MAJOR_INLIERS=10
BODY_PARTS__IDENTITY_MIN_INLIERS=50
BODY_PARTS__SINGLE_PART_SUSPECT_MIN_INLIERS=18

# -----------------------------------------------------------------------------
# ระดับคะแนนรวมและการจัดกลุ่ม
# ต้องคงลำดับ VERY_HIGH > HIGH > POSSIBLE
# -----------------------------------------------------------------------------
RELATIONSHIP__VERY_HIGH_THRESHOLD=0.90
RELATIONSHIP__HIGH_THRESHOLD=0.80
RELATIONSHIP__POSSIBLE_THRESHOLD=0.65
# เพิ่ม = กลุ่มแยกย่อยและเข้มงวดขึ้น; ลด = เชื่อมกลุ่มง่ายและเสี่ยงสะพานผิด
RELATIONSHIP__GRAPH_EDGE_THRESHOLD=0.65
# same_image ต้องมี RANSAC ratio อย่างน้อยเท่านี้
RELATIONSHIP__SAME_IMAGE_MIN_INLIER_RATIO=0.50

# น้ำหนักคะแนนรวม ต้องรวมกันเท่ากับ 1.00
# เพิ่มน้ำหนักใด = เทคโนโลยีนั้นมีอิทธิพลต่อคะแนนรวมมากขึ้น
RELATIONSHIP__WEIGHTS__PHASH=0.15
RELATIONSHIP__WEIGHTS__EMBEDDING=0.45
RELATIONSHIP__WEIGHTS__SIFT=0.05
RELATIONSHIP__WEIGHTS__RANSAC=0.35

# -----------------------------------------------------------------------------
# การใช้บางส่วน/เปลี่ยนฉาก
# เพิ่ม = เข้มงวดขึ้น; ลด = ผ่านง่ายขึ้นแต่ false positive เพิ่ม
# -----------------------------------------------------------------------------
RELATIONSHIP__PARTIAL_REUSE_MIN_INLIERS=30
RELATIONSHIP__PARTIAL_REUSE_MIN_INLIER_RATIO=0.20
RELATIONSHIP__BACKGROUND_REPLACED_MIN_EMBEDDING_SIMILARITY=0.45
RELATIONSHIP__FOREGROUND_SOURCE_MIN_INLIERS=30
RELATIONSHIP__FOREGROUND_SOURCE_MIN_INLIER_RATIO=0.55
RELATIONSHIP__FOREGROUND_SOURCE_MIN_COVERAGE=0.08

# -----------------------------------------------------------------------------
# เช็กอินซ้ำ: ต้องมีทั้งฉากและส่วนบุคคลเป็นหลักฐานอิสระ
# เพิ่ม = เข้มงวดขึ้น; ลด = ส่งตรวจสอบง่ายขึ้น
# -----------------------------------------------------------------------------
RELATIONSHIP__REPEATED_CHECKIN_MIN_FOREGROUND_INLIERS=8
RELATIONSHIP__REPEATED_CHECKIN_MIN_FOREGROUND_RATIO=0.50
RELATIONSHIP__REPEATED_CHECKIN_MIN_FOREGROUND_COVERAGE=0.02
RELATIONSHIP__REPEATED_CHECKIN_MIN_IDENTITY_INLIERS=6
RELATIONSHIP__REPEATED_CHECKIN_MIN_REUSE_INLIERS=4

# -----------------------------------------------------------------------------
# ภาพถ่ายซ้ำผ่านหน้าจอ/อุปกรณ์
# เพิ่ม = เข้มงวดขึ้น; ลด = ตรวจเจอง่ายขึ้น
# -----------------------------------------------------------------------------
RELATIONSHIP__RECAPTURE_MIN_INLIERS=40
RELATIONSHIP__RECAPTURE_MIN_INLIER_RATIO=0.30
RELATIONSHIP__RECAPTURE_MIN_COVERAGE=0.18
RELATIONSHIP__RECAPTURE_MIN_EMBEDDING_SIMILARITY=0.60

# -----------------------------------------------------------------------------
# ภาพเบลอ/ครอปและ fallback ทั้งภาพ
# BLUR_VARIANCE_THRESHOLD เพิ่ม = จัดภาพเป็นภาพเบลอง่ายขึ้น
# ค่า MIN อื่นเพิ่ม = เข้มงวดขึ้น; ลด = ผ่านง่ายขึ้น
# -----------------------------------------------------------------------------
RELATIONSHIP__BLUR_VARIANCE_THRESHOLD=160.0
RELATIONSHIP__BLURRED_CROP_MIN_INLIERS=12
RELATIONSHIP__BLURRED_CROP_MIN_INLIER_RATIO=0.25
RELATIONSHIP__BLURRED_CROP_MIN_EMBEDDING_SIMILARITY=0.55
# เพิ่ม = ยอมให้ภาพรวมต่างกันมากขึ้น; ลด = ต้องใกล้ต้นฉบับขึ้น
RELATIONSHIP__BLURRED_CROP_MAX_PHASH_DISTANCE=22
RELATIONSHIP__BLURRED_WHOLE_MIN_INLIERS=18
RELATIONSHIP__BLURRED_WHOLE_MIN_INLIER_RATIO=0.45
RELATIONSHIP__BLURRED_WHOLE_MIN_COVERAGE=0.08
RELATIONSHIP__BLURRED_WHOLE_STRONG_INLIER_RATIO=0.75

# -----------------------------------------------------------------------------
# ประสิทธิภาพ CPU
# -----------------------------------------------------------------------------
PERFORMANCE__AUTO_TUNE=true
# 0 = เลือกอัตโนมัติ
PERFORMANCE__CPU_WORKERS=0
PERFORMANCE__OPENCV_THREADS=0
PERFORMANCE__PAIR_CHUNK_SIZE=16
